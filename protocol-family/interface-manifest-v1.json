          "type": "object-or-null",
          "required_members": [
            "starts_at",
            "ends_at"
          ],
          "timestamp": "whole-second-utc",
          "ordering": "starts_at-before-ends_at"
        },
        "instance_attestation_v2": {
          "predicate_id": "afp.telemetry.instance_attestation.v2",
          "required_non_null_members": [
            "root_class",
            "root_authority_identifier",
            "attestation_window",
            "subject_aid"
          ],
          "root_classes": [
            "root:build-provenance",
            "root:tee-attestation",
            "root:publisher-manifest"
          ],
          "root_policy": "exact-class-authority-pair"
        },
        "non_instance_attestation_root_fields": "must-be-null"
      },
      "required_predicate_policy": {
        "location": "afp.required_predicate_policy",
        "result_member": false,
        "required_members": [
          "accepted_predicate_ids",
          "required_predicate_ids",
          "accepted_instance_attestation_roots"
        ],
        "accepted_predicate_ids": "nonempty-unique-sorted-array",
        "required_predicate_ids": "unique-sorted-subset-of-accepted",
        "accepted_instance_attestation_roots": "unique-sorted-exact-class-authority-pairs",
        "instance_attestation_root_biconditional": true
      },
      "predicate_field_classification": {
        "predicate_id": "bound",
        "predicate_version": "bound",
        "root_class": "bound",
        "root_authority_identifier": "bound",
        "attestation_window": "free",
        "subject_aid": "free"
      },
      "subject_assurance": {
        "non_result_metadata": true,
        "basis": [
          "issuer-authenticated-aid-claim",
          "verified-companion-subject-binding-proof"
        ]
      },
      "telemetry_fixture_predicates": [
        "afp.telemetry.instance_attestation.v2"
      ],
      "generic_zkc_predicates_are_insufficient": true
