          "pointer": "/predicate_fields",
          "expected": [
            {
              "field": "predicate_id",
              "classification": "bound",
              "comparand": "required_predicates.accepted_predicate_ids, required_predicate_ids, and the closed section 6.3 catalog on the telemetry flow",
              "spec_reference": "6.3, 14.4",
              "rationale": "What was proven, matched against what the flow requires and accepts."
            },
            {
              "field": "predicate_version",
              "classification": "bound",
              "comparand": "the version token of predicate_id",
              "spec_reference": "6.3, 6.3.1",
              "rationale": "Bound at construction so that an unsupported predicate version is detectable rather than a free label."
            },
            {
              "field": "root_class",
              "classification": "bound",
              "comparand": "required_predicates.accepted_instance_attestation_roots and the three literal section 6.3.1 root classes",
              "spec_reference": "6.3.1, 14.4",
              "rationale": "An unknown class is rejected. Only instance attestation v2 may carry one: section 6.3.1 freezes v1 semantically, so a v1 proof must not be reinterpreted as carrying a generic root class. The section 14.4 comparison keys on the predicate identifier rather than on whether a root is present, so a v2 attestation that names no root class is rejected rather than skipped."
            },
            {
              "field": "root_authority_identifier",
              "classification": "bound",
              "comparand": "required_predicates.accepted_instance_attestation_roots",
              "spec_reference": "14.4",
              "rationale": "The pair must exactly match one signed accepted pair. Resolving that authority's key state, delegation chain, and revocation from its KEL is a separate section 6.3.1 obligation, discharged at the introduction tier only when a root_authority_resolver is supplied."
            },
            {
              "field": "attestation_window",
              "classification": "free",
              "comparand": null,
              "spec_reference": "6.3.1, 14.3",
              "rationale": "Validated for canonical whole-second UTC shape and ordering at construction, but the presentation seam holds no authenticated window to compare it against. The introduction tier binds it: evaluate_credentialing requires it to equal the introduction request's explicit window."
            },
            {
              "field": "subject_aid",
              "classification": "free",
              "comparand": null,
              "spec_reference": "6.3.1",
              "rationale": "Required to be present for instance attestation, but not compared at the presentation seam. The introduction tier binds it to the presenting tenant."
            }
          ]
