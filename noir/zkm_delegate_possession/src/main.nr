// ZKM delegate-key possession circuit — the §6 possession statement as a
// COMPANION proof to a DELEGATE transition.
//
// WHY A SEPARATE PROOF. §6 requires every DELEGATE and ROTATE to establish
// knowledge of the private key behind the successor's `holder_key` — without
// it, delegating to an uncontrolled key silently burns authority (a
// delegator-side loss equivalent to RETIRE, unintended). But that knowledge
// cannot live inside the delegator's transition proof: the transition witness
// is the DELEGATOR's, so witnessing `delegate_sk` there would require the
// delegate to hand its secret to the delegator — exactly the impersonation
// collapse §6 forbids (in ZKM the nullifier secret derives from the same key,
// so a shared key is the whole mandate). The possession statement is therefore
// its own proof, generated by the DELEGATE with its own secret, and conjoined
// with the transition at settlement by SHARED PUBLIC INPUTS — the same
// composition idiom §5 already uses for the spend-conjoined form.
//
// STATEMENT. "I know `delegate_sk` such that the §3 mandate commitment
// `cm_successor` opens to a note whose `holder_key` is derived from
// `delegate_sk` (KDC tag `zkm/holder_key/v1`), in settlement context
// `settlement_context`, for the transition that emits mandate nullifier `nf`."
//
// SETTLEMENT MATCHING RULE (§5). A settlement layer MUST NOT accept a
// DELEGATE_FULL, DELEGATE_PARTIAL or ROTATE transition on the mandate-only VK
// unless it also verifies a proof under
// THIS VK whose public vector matches the transition's: `cm_successor` equals
// the transition's delegate-bound successor commitment (`cm_out_1`), and `nf`
// and `settlement_context` equal the transition's. Binding `nf` makes each
// possession proof single-use per consumed note (nf is the settlement dedup
// key, §4.3-4); binding `cm_successor` ties it to exactly the note the
// delegate will control; binding `settlement_context` is the same domain
// hygiene every ZKM proof carries.
//
// WHAT THIS DOES AND DOES NOT ESTABLISH. It establishes that SOME party
// demonstrated control of the successor's key for THIS transition, in a way
// the delegator alone cannot fabricate without knowing `delegate_sk`. It does
// NOT establish that the delegator does not ALSO know the key (§6: a key
// shared with or supplied by the delegator collapses delegation into
// impersonation — unprovable in-circuit; the §6 ceremony requires the
// delegate to generate its key fresh). It carries NO authority: this VK has
// no cap, no amount, no membership proof — accepting it alone settles
// nothing. Privacy: all three public inputs are values the matched transition
// already makes public, so the companion proof adds ZERO disclosure (§4.6).
//
// The delegate necessarily knows the successor opening it witnesses here —
// a delegate that could not open its own note could never transition it
// (§4.3). The opening is handed over in the §6 ceremony, in exchange for
// this proof.

use zkm_lib::{compute_mandate_commitment, derive_holder_key, MandateNote};

fn main(
    // ---- public inputs -------------------------------------------------
    // The delegate-bound successor commitment: MUST equal the matched
    // transition's `cm_out_1` (both DELEGATE kinds bind the delegate leg to
    // successor slot 1).
    cm_successor: pub Field,
    // The matched transition's mandate nullifier. Not recomputable here (it
    // is a function of the DELEGATOR's secret); bound as context so this
    // proof is single-use per consumed note.
    nf: pub Field,
    // Settlement-domain binding (§5), asserted equal to the successor's
    // committed `settlement_domain` below.
    settlement_context: pub Field,
    // ---- private witnesses ---------------------------------------------
    // The delegate's secret. `holder_key` is NOT witnessed: it is derived,
    // which is the entire statement.
    delegate_sk: Field,
    // The successor note opening (§3), as created by the delegator and
    // handed to the delegate in the §6 ceremony.
    root_id: Field,
    settlement_domain: Field,
    asset_id: Field,
    remaining_cap: u128,
    expiry: u64,
    policy_hash: Field,
    depth: u8,
    randomness: Field,
) {
    // Zero is the §3 "field absent" sentinel throughout; a proof over absent
    // fields is a proof of nothing and MUST NOT verify.
    assert(cm_successor != 0, "successor commitment must be non-zero");
    assert(nf != 0, "mandate nullifier must be non-zero");
    assert(root_id != 0, "root_id must be non-zero");
    assert(asset_id != 0, "asset_id must be non-zero");
    assert(policy_hash != 0, "policy_hash must be non-zero");

    // §3/§5 authority-domain binding, mirroring `verify_input_mandate`.
    assert(
        settlement_domain == settlement_context,
        "mandate settlement domain must match the settlement context",
    );

    // NOTE (rev 5): no depth constraint. This companion also serves ROTATE
    // (§6 cross-holder handoff), whose successor PRESERVES depth — including
    // depth 0 for a principal's own agent rotating the original mandate. A
    // possession proof carries no authority (see header), so attesting a
    // depth-0 rebind target is not a repurposing hazard.

    // THE STATEMENT: the successor's holder key is derived from a secret the
    // prover knows.
    let holder_key = derive_holder_key(delegate_sk);
    assert(holder_key != 0, "delegate holder key must be non-zero");

    let cm = compute_mandate_commitment(
        MandateNote {
            root_id,
            settlement_domain,
            asset_id,
            remaining_cap,
            expiry,
            policy_hash,
            holder_key,
            depth,
            randomness,
        },
    );
    assert(cm == cm_successor, "successor commitment does not open to the delegate's key");
}

// =============================================================================
// Tests
//
// These isolated unit fixtures use an opaque policy hash. Real settlement
// companions are generated by scripts/generate-proof-fixtures.sh from each
// transition emitter's actual first-successor opening, including its computed
// policy hash. Parameter resemblance alone does not establish a matched pair.
// =============================================================================

use zkm_lib::{
    compute_mandate_commitment as cmc, compute_mandate_nullifier, compute_mandate_root_id,
    derive_holder_nullifier_secret,
};

global HOLDER_SK: Field = 4242;
global DELEGATE_SK: Field = 7373;
global THIRD_PARTY_SK: Field = 8484;
global PRINCIPAL_ISSUANCE_KEY: Field = 991;
global ISSUANCE_RANDOMNESS: Field = 13;
global ASSET_ID: Field = 7;
global POLICY_HASH: Field = 33;
global IN_RANDOMNESS: Field = 555;
global OUT1_RANDOMNESS: Field = 6001;
global CAP: u128 = 1000;
global EXPIRY: u64 = 2000;
global SETTLEMENT_CONTEXT: Field = 0x5e77_1e3c;

struct Possession {
    cm_successor: Field,
    nf: Field,
    settlement_context: Field,
    delegate_sk: Field,
    root_id: Field,
    settlement_domain: Field,
    asset_id: Field,
    remaining_cap: u128,
    expiry: u64,
    policy_hash: Field,
    depth: u8,
    randomness: Field,
}

impl Possession {
    fn run(self) {
        main(
            self.cm_successor,
            self.nf,
            self.settlement_context,
            self.delegate_sk,
            self.root_id,
            self.settlement_domain,
            self.asset_id,
            self.remaining_cap,
            self.expiry,
            self.policy_hash,
            self.depth,
            self.randomness,
        );
    }
}

/// An isolated delegate-bound successor plus a consumed-note nullifier.
/// `cap`/`depth` parameters cover the DELEGATE_PARTIAL delegate leg too.
fn possession_of(cap: u128, depth: u8) -> Possession {
    let root_id = compute_mandate_root_id(PRINCIPAL_ISSUANCE_KEY, ISSUANCE_RANDOMNESS);
    // The CONSUMED (delegator) note, only to reproduce the transition's nf.
    let cm_in = cmc(
        MandateNote {
            root_id,
            settlement_domain: SETTLEMENT_CONTEXT,
            asset_id: ASSET_ID,
            remaining_cap: CAP,
            expiry: EXPIRY,
            policy_hash: POLICY_HASH,
            holder_key: derive_holder_key(HOLDER_SK),
            depth: 0,
            randomness: IN_RANDOMNESS,
        },
    );
    let nf = compute_mandate_nullifier(
        derive_holder_nullifier_secret(HOLDER_SK),
        cm_in,
        SETTLEMENT_CONTEXT,
    );
    let cm_successor = cmc(
        MandateNote {
            root_id,
            settlement_domain: SETTLEMENT_CONTEXT,
            asset_id: ASSET_ID,
            remaining_cap: cap,
            expiry: EXPIRY,
            policy_hash: POLICY_HASH,
            holder_key: derive_holder_key(DELEGATE_SK),
            depth,
            randomness: OUT1_RANDOMNESS,
        },
    );
    Possession {
        cm_successor,
        nf,
        settlement_context: SETTLEMENT_CONTEXT,
        delegate_sk: DELEGATE_SK,
        root_id,
        settlement_domain: SETTLEMENT_CONTEXT,
        asset_id: ASSET_ID,
        remaining_cap: cap,
        expiry: EXPIRY,
        policy_hash: POLICY_HASH,
        depth,
        randomness: OUT1_RANDOMNESS,
    }
}

// ---- positive ---------------------------------------------------------------

#[test]
fn test_possession_of_full_rebind_successor() {
    // Full-rebind shape; real cross-package matching is checked by the generator.
    possession_of(CAP, 1).run();
}

#[test]
fn test_possession_of_partial_delegate_leg() {
    // Partial delegate-leg shape; this unit fixture uses an opaque policy hash.
    possession_of(250, 1).run();
}

#[test]
fn test_possession_at_deep_delegation() {
    possession_of(CAP, 255).run();
}

// ---- negative ---------------------------------------------------------------

#[test(should_fail_with = "successor commitment does not open to the delegate's key")]
fn test_wrong_secret_rejected() {
    // The exact §6 hazard: a party that does not control the key inside the
    // successor cannot produce this proof.
    let mut p = possession_of(CAP, 1);
    p.delegate_sk = THIRD_PARTY_SK;
    p.run();
}

#[test(should_fail_with = "successor commitment does not open to the delegate's key")]
fn test_delegator_secret_rejected() {
    // The delegator's own secret does not open the delegate-bound successor —
    // the delegator alone cannot fabricate possession.
    let mut p = possession_of(CAP, 1);
    p.delegate_sk = HOLDER_SK;
    p.run();
}

#[test(should_fail_with = "successor commitment does not open to the delegate's key")]
fn test_tampered_commitment_rejected() {
    let mut p = possession_of(CAP, 1);
    p.cm_successor += 1;
    p.run();
}

#[test(should_fail_with = "successor commitment does not open to the delegate's key")]
fn test_tampered_cap_rejected() {
    // The opening is bound in full: any drifted field is a different note.
    let mut p = possession_of(CAP, 1);
    p.remaining_cap -= 1;
    p.run();
}

#[test(should_fail_with = "mandate settlement domain must match the settlement context")]
fn test_domain_mismatch_rejected() {
    let mut p = possession_of(CAP, 1);
    p.settlement_domain = SETTLEMENT_CONTEXT + 1;
    p.run();
}

#[test(should_fail_with = "successor commitment must be non-zero")]
fn test_zero_commitment_rejected() {
    let mut p = possession_of(CAP, 1);
    p.cm_successor = 0;
    p.run();
}

#[test(should_fail_with = "mandate nullifier must be non-zero")]
fn test_zero_nullifier_rejected() {
    let mut p = possession_of(CAP, 1);
    p.nf = 0;
    p.run();
}

#[test(should_fail_with = "root_id must be non-zero")]
fn test_zero_root_id_rejected() {
    let mut p = possession_of(CAP, 1);
    p.root_id = 0;
    p.run();
}

#[test(should_fail_with = "asset_id must be non-zero")]
fn test_zero_asset_id_rejected() {
    let mut p = possession_of(CAP, 1);
    p.asset_id = 0;
    p.run();
}

#[test(should_fail_with = "policy_hash must be non-zero")]
fn test_zero_policy_hash_rejected() {
    let mut p = possession_of(CAP, 1);
    p.policy_hash = 0;
    p.run();
}

#[test]
fn test_possession_at_depth_zero_rotation_target() {
    // A ROTATE successor preserves depth — 0 included (§6 handoff of the
    // original mandate). The companion must cover it.
    possession_of(CAP, 0).run();
}

// =============================================================================
// Prover.toml emission for the bb proving harness (scripts/prove-shape-classes.sh)
// — same one-source-of-truth pattern as zkm_mandate_transition: the witness
// that gets PROVED is built by the same fixture the assertion suite tests.
// =============================================================================

fn emit_prover_toml(p: Possession) {
    let cm_successor = p.cm_successor;
    let nf = p.nf;
    let settlement_context = p.settlement_context;
    println(f"cm_successor={cm_successor}");
    println(f"nf={nf}");
    println(f"settlement_context={settlement_context}");

    let delegate_sk = p.delegate_sk;
    let root_id = p.root_id;
    let settlement_domain = p.settlement_domain;
    let asset_id = p.asset_id;
    let remaining_cap = p.remaining_cap;
    let expiry = p.expiry;
    let policy_hash = p.policy_hash;
    let depth = p.depth;
    let randomness = p.randomness;
    println(f"delegate_sk={delegate_sk}");
    println(f"root_id={root_id}");
    println(f"settlement_domain={settlement_domain}");
    println(f"asset_id={asset_id}");
    println(f"remaining_cap={remaining_cap}");
    println(f"expiry={expiry}");
    println(f"policy_hash={policy_hash}");
    println(f"depth={depth}");
    println(f"randomness={randomness}");
}

#[test]
fn emit_toml_possession() {
    emit_prover_toml(possession_of(CAP, 1));
}
