# noir/scripts/prover-toml.awk
#
# Turn the `key=value` / `key[]=value` stream emitted by the `emit_toml_*` Noir
# tests into a Prover.toml.
#
# WHY AN INTERMEDIATE FORMAT AT ALL. A ZKM witness cannot be hand-written — the
# sibling arrays are iterated Poseidon2 empty-subtree roots and every root,
# commitment and nullifier must be mutually consistent with them — so it is
# emitted from the same Noir fixture helpers the test suite uses. But a Noir
# f-string cannot contain an escaped `"`, so Noir cannot print TOML directly.
# It prints unquoted `key=value` lines; this script adds the quoting.
#
# Every value is quoted, including integers. nargo accepts decimal strings for
# u8/u64/u128 and hex strings for Field, and quoting uniformly avoids TOML's
# 64-bit integer range limit (a Field is ~254 bits and would overflow a bare
# TOML int).
#
# Anything that is not a `key=value` line — nargo's test harness banners, the
# `--- stdout ---` rules — is ignored, so the emitting test's output can be
# piped in raw.
#
# Usage:
#   nargo test --show-output emit_toml_split | awk -f scripts/prover-toml.awk > Prover.toml

BEGIN { n_scalar = 0; n_array = 0 }

# Array element: `name[]=value`. Accumulate in emission order.
/^[a-z_][a-z0-9_]*\[\]=/ {
    key = substr($0, 1, index($0, "[]=") - 1)
    val = substr($0, index($0, "[]=") + 3)
    if (!(key in arr_seen)) {
        arr_seen[key] = 1
        array_order[n_array++] = key
        arr[key] = ""
    }
    arr[key] = arr[key] (arr[key] == "" ? "" : ", ") "\"" val "\""
    next
}

# Scalar: `name=value`.
/^[a-z_][a-z0-9_]*=/ {
    key = substr($0, 1, index($0, "=") - 1)
    val = substr($0, index($0, "=") + 1)
    if (key in scalar_seen) {
        printf "prover-toml.awk: duplicate key %s\n", key > "/dev/stderr"
        exit 2
    }
    scalar_seen[key] = 1
    scalar_order[n_scalar++] = key
    scalar[key] = val
    next
}

END {
    if (n_scalar == 0 && n_array == 0) {
        print "prover-toml.awk: no key=value lines on stdin (did the emit test run with --show-output?)" > "/dev/stderr"
        exit 2
    }
    print "# GENERATED by the emit_toml_* Noir tests via scripts/prover-toml.awk."
    print "# Do not edit, and do not commit: Prover.toml is gitignored on purpose."
    for (i = 0; i < n_scalar; i++) {
        k = scalar_order[i]
        printf "%s = \"%s\"\n", k, scalar[k]
    }
    for (i = 0; i < n_array; i++) {
        k = array_order[i]
        printf "%s = [%s]\n", k, arr[k]
    }
}
