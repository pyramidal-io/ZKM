    function isAuthorizedZkmVerifier(bytes32 statementId, address verifier, bytes32 vkHash) external view returns (bool);
    /// @notice Atomically check-and-insert both nullifiers and all commitments.
    /// @dev MUST reject duplicates in the target-owned mandate and ZKA state,
