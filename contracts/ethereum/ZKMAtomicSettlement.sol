/// @title ZKMAtomicSettlement
/// @notice Fixed-VK direct settlement boundary for optional ZKM authorization.
/// @dev Ordinary ZKA withdrawal never calls this contract. The target call and
///      both nullifier writes share one EVM transaction and therefore revert as
///      a unit if any state effect fails.
contract ZKMAtomicSettlement {
    // Deliberate measurement/platform deviation from canonical OZ 5.1's
    // persistent-storage guard. Requires Cancun; gas/refunds are NOT equal.
    // Preserve the canonical public error identity.
    error ReentrancyGuardReentrantCall();
    bytes32 private constant _GUARD_SLOT = keccak256("zkm.atomic_settlement.reentrancy.guard");

    modifier nonReentrant() {
        bytes32 slot = _GUARD_SLOT;
        bool entered;
        assembly ("memory-safe") {
            entered := tload(slot)
        }
        if (entered) revert ReentrancyGuardReentrantCall();
        assembly ("memory-safe") {
            tstore(slot, 1)
        }
        _;
        assembly ("memory-safe") {
            tstore(slot, 0)
        }
    }

    uint256 internal constant FIELD_MODULUS =
        21888242871839275222246405745257275088548364400416034343698204186575808495617;
    bytes32 public constant SPEND_CONJOINED_STATEMENT_ID = keccak256("zkm:spend-conjoined:v2");
    bytes32 public constant MANDATE_ONLY_STATEMENT_ID = keccak256("zkm:mandate-only:v2");
    bytes32 public constant POSSESSION_STATEMENT_ID = keccak256("zkm:possession:v1");
    /// @dev The only ZKM revocation-accumulator profile these VKs accept: the
    ///      depth-254 full-identifier exclusion tree. Pre-cutover scheme 1 (the
    ///      depth-128 low-half tree) is not reinterpreted under scheme 2.
    uint8 public constant REVOCATION_SCHEME = 2;
    uint64 public constant NO_LEAF_INDEX = type(uint64).max;
    bytes32 public constant PROOF_SCHEME = bytes32("ultra_honk");
    bytes32 public constant TRANSCRIPT_TARGET = bytes32("evm");

    struct SpendPublicInputs {
        uint8 kind;
        bytes32 mandateNullifier;
        bytes32 mandateSuccessorCommitment;
        bytes32 mandateSecondSuccessorCommitment;
        bytes32 mandateRoot;
        bytes32 revocationRoot;
        uint8 revocationScheme;
        uint64 currentTime;
        bytes32 settlementContext;
        bytes32 assetId;
        bytes32 zkaNoteRoot;
        bytes32 zkaNullifier;
        bytes32 zkaRecipientCommitment;
        bytes32 zkaChangeCommitment;
    }

    struct MandatePublicInputs {
        uint8 kind;
        bytes32 mandateNullifier;
        bytes32 mandateSuccessorCommitment;
        bytes32 mandateSecondSuccessorCommitment;
        bytes32 mandateRoot;
        bytes32 revocationRoot;
        uint8 revocationScheme;
        uint64 currentTime;
        bytes32 settlementContext;
    }

    struct ClockSnapshot {
        uint64 targetTime;
        uint64 proofTimeWindow;
    }

    struct SettlementEvidenceData {
        address verifier;
        bytes32 vkHash;
        bytes32[] publicInputs;
        bytes proof;
        IZKMSettlementTarget.MandateLeafIndices indices;
        ClockSnapshot clock;
    }

    IZKMSettlementTarget public immutable TARGET;
    IUltraVerifier public immutable SPEND_CONJOINED_VERIFIER;
    IUltraVerifier public immutable MANDATE_ONLY_VERIFIER;
    IUltraVerifier public immutable POSSESSION_VERIFIER;
    bytes32 public immutable SPEND_CONJOINED_VK_HASH;
    bytes32 public immutable MANDATE_ONLY_VK_HASH;
    bytes32 public immutable POSSESSION_VK_HASH;

    error ZeroAddress();
    error NoCode();
    error InvalidField();
    error InvalidVerificationKeyHash();
    error UnauthorizedVerificationKey();
    error InvalidTransition();
    error InvalidRevocationScheme();
    error ContextMismatch();
    error AssetMismatch();
    error TimeMismatch();
    error UnknownMandateRoot();
    error UnknownZkaNoteRoot();
    error UnknownRevocationRoot();
    error InvalidProof();
    error MissingPossessionProof();
    error InvalidMandateLeafIndices();

    event ZkmSpendSettled(
        bytes32 indexed mandateNullifier,
        bytes32 indexed zkaNullifier,
        bytes32 mandateSuccessorCommitment,
        bytes32 zkaRecipientCommitment,
        bytes32 zkaChangeCommitment
    );
    event ZkmMandateTransitionSettled(
        bytes32 indexed mandateNullifier, bytes32 mandateSuccessorCommitment, bytes32 mandateSecondSuccessorCommitment
    );

    /// @notice Public proof evidence; private note openings remain holder-side.
    /// @dev Inclusion order is the authenticated EVM block/transaction/log order.
    event ZkmSettlementEvidence(
        bytes32 indexed mandateNullifier,
        bytes32 indexed statementId,
        address indexed target,
        address verifier,
        bytes32 proofScheme,
        bytes32 transcriptTarget,
        bytes32 vkHash,
        bytes32[] publicInputs,
        bytes proof,
        uint64 successorLeafIndex,
        uint64 secondSuccessorLeafIndex,
        uint64 targetTime,
        uint64 proofTimeWindow
    );
    event ZkmPossessionEvidence(
        bytes32 indexed mandateNullifier,
        bytes32 indexed statementId,
        address indexed target,
        address verifier,
        bytes32 proofScheme,
        bytes32 transcriptTarget,
        bytes32 vkHash,
        bytes32[3] publicInputs,
        bytes proof
    );

    constructor(
        address target,
        address spendConjoinedVerifier,
        bytes32 spendConjoinedVkHash,
        address mandateOnlyVerifier,
        bytes32 mandateOnlyVkHash,
        address possessionVerifier,
        bytes32 possessionVkHash
    ) {
        if (
            target == address(0) || spendConjoinedVerifier == address(0) || mandateOnlyVerifier == address(0)
                || possessionVerifier == address(0)
        ) {
            revert ZeroAddress();
        }
        if (
            target.code.length == 0 || spendConjoinedVerifier.code.length == 0 || mandateOnlyVerifier.code.length == 0
                || possessionVerifier.code.length == 0
        ) {
            revert NoCode();
        }
        _requireNonzeroDigest(spendConjoinedVkHash);
        _requireNonzeroDigest(mandateOnlyVkHash);
        _requireNonzeroDigest(possessionVkHash);

        IZKMSettlementTarget settlementTarget = IZKMSettlementTarget(target);
        if (
            !settlementTarget.isAuthorizedZkmVerifier(
                    SPEND_CONJOINED_STATEMENT_ID, spendConjoinedVerifier, spendConjoinedVkHash
                )
                || !settlementTarget.isAuthorizedZkmVerifier(
                    MANDATE_ONLY_STATEMENT_ID, mandateOnlyVerifier, mandateOnlyVkHash
                )
                || !settlementTarget.isAuthorizedZkmVerifier(
                    POSSESSION_STATEMENT_ID, possessionVerifier, possessionVkHash
                )
        ) {
            revert UnauthorizedVerificationKey();
        }

        TARGET = settlementTarget;
        SPEND_CONJOINED_VERIFIER = IUltraVerifier(spendConjoinedVerifier);
        MANDATE_ONLY_VERIFIER = IUltraVerifier(mandateOnlyVerifier);
        SPEND_CONJOINED_VK_HASH = spendConjoinedVkHash;
        MANDATE_ONLY_VK_HASH = mandateOnlyVkHash;
        POSSESSION_VERIFIER = IUltraVerifier(possessionVerifier);
        POSSESSION_VK_HASH = possessionVkHash;
    }

    /// @notice Verify `zkm:spend-conjoined:v2` and apply all five effects.
    function settleSpend(SpendPublicInputs calldata value, bytes calldata proof) external nonReentrant {
        _requireAuthorizedVerifier(SPEND_CONJOINED_STATEMENT_ID, SPEND_CONJOINED_VERIFIER, SPEND_CONJOINED_VK_HASH);
        if (value.kind != 0 || value.mandateSecondSuccessorCommitment != bytes32(0)) {
            revert InvalidTransition();
        }
        ClockSnapshot memory clock = _validateCommon(
            value.mandateNullifier,
            value.mandateRoot,
            value.revocationRoot,
            value.revocationScheme,
            value.currentTime,
            value.settlementContext
        );
        _requireNonzeroField(value.assetId);
        if (value.assetId != TARGET.zkmAssetId()) revert AssetMismatch();
        _requireNonzeroField(value.zkaNoteRoot);
        if (!TARGET.isRecentZkaNoteRoot(value.zkaNoteRoot)) revert UnknownZkaNoteRoot();
        _requireNonzeroField(value.zkaNullifier);
        _requireNonzeroField(value.mandateSuccessorCommitment);
        _requireNonzeroField(value.zkaRecipientCommitment);
        _requireNonzeroField(value.zkaChangeCommitment);

        bytes32[] memory publicInputs = new bytes32[](14);
        publicInputs[0] = bytes32(uint256(value.kind));
        publicInputs[1] = value.mandateNullifier;
        publicInputs[2] = value.mandateSuccessorCommitment;
        publicInputs[3] = value.mandateSecondSuccessorCommitment;
        publicInputs[4] = value.mandateRoot;
        publicInputs[5] = value.revocationRoot;
        publicInputs[6] = bytes32(uint256(value.revocationScheme));
        publicInputs[7] = bytes32(uint256(value.currentTime));
        publicInputs[8] = value.settlementContext;
        publicInputs[9] = value.assetId;
        publicInputs[10] = value.zkaNoteRoot;
        publicInputs[11] = value.zkaNullifier;
        publicInputs[12] = value.zkaRecipientCommitment;
        publicInputs[13] = value.zkaChangeCommitment;
        if (!_verify(SPEND_CONJOINED_VERIFIER, proof, publicInputs)) revert InvalidProof();

        IZKMSettlementTarget.MandateLeafIndices memory indices = TARGET.applyZkmSpend(
            IZKMSettlementTarget.SpendEffects({
                mandateNullifier: value.mandateNullifier,
                mandateSuccessorCommitment: value.mandateSuccessorCommitment,
                zkaNullifier: value.zkaNullifier,
                zkaRecipientCommitment: value.zkaRecipientCommitment,
                zkaChangeCommitment: value.zkaChangeCommitment
            })
        );

        _requireMandateLeafIndices(value.mandateSuccessorCommitment, value.mandateSecondSuccessorCommitment, indices);
        _emitSettlementEvidence(true, publicInputs, proof, indices, clock);
        emit ZkmSpendSettled(
            value.mandateNullifier,
            value.zkaNullifier,
            value.mandateSuccessorCommitment,
            value.zkaRecipientCommitment,
            value.zkaChangeCommitment
        );
    }

    /// @notice Verify a non-value transition that does not require possession.
    /// @dev Every DELEGATE_FULL, DELEGATE_PARTIAL, and ROTATE must use the companion-bearing entry point.
    function settleMandateTransition(MandatePublicInputs calldata value, bytes calldata proof) external nonReentrant {
        if (_requiresPossession(value.kind)) revert MissingPossessionProof();
        _settleMandateTransition(value, proof);
    }

    /// @notice Verify a mandate transition and its matched possession companion.
    /// @dev Required for every DELEGATE_FULL (3), DELEGATE_PARTIAL (4), and
    ///      ROTATE (5). A supplied proof is always verified.
    ///      Public inputs are derived here, never selected independently by callers.
    function settleMandateTransitionWithPossession(
        MandatePublicInputs calldata value,
        bytes calldata proof,
        bytes calldata possessionProof
    ) external nonReentrant {
        if (possessionProof.length == 0) {
            if (_requiresPossession(value.kind)) revert MissingPossessionProof();
        } else {
            _requireAuthorizedVerifier(POSSESSION_STATEMENT_ID, POSSESSION_VERIFIER, POSSESSION_VK_HASH);
            _requireNonzeroField(value.mandateSuccessorCommitment);
            _requireNonzeroField(value.mandateNullifier);
            _requireNonzeroField(value.settlementContext);
            bytes32[] memory publicInputs = new bytes32[](3);
            publicInputs[0] = value.mandateSuccessorCommitment;
            publicInputs[1] = value.mandateNullifier;
            publicInputs[2] = value.settlementContext;
            if (!_verify(POSSESSION_VERIFIER, possessionProof, publicInputs)) revert InvalidProof();
        }
        _settleMandateTransition(value, proof);
        if (possessionProof.length != 0) _emitPossessionEvidence(value, possessionProof);
    }

    function _emitPossessionEvidence(MandatePublicInputs calldata value, bytes calldata possessionProof) private {
        bytes32[3] memory publicInputs =
            [value.mandateSuccessorCommitment, value.mandateNullifier, value.settlementContext];
        emit ZkmPossessionEvidence(
            value.mandateNullifier,
            POSSESSION_STATEMENT_ID,
            address(TARGET),
            address(POSSESSION_VERIFIER),
            PROOF_SCHEME,
            TRANSCRIPT_TARGET,
            POSSESSION_VK_HASH,
            publicInputs,
            possessionProof
        );
    }

    function _requiresPossession(uint8 kind) internal pure returns (bool) {
        return kind == 3 || kind == 4 || kind == 5;
    }

    function _settleMandateTransition(MandatePublicInputs calldata value, bytes calldata proof) internal {
        _requireAuthorizedVerifier(MANDATE_ONLY_STATEMENT_ID, MANDATE_ONLY_VERIFIER, MANDATE_ONLY_VK_HASH);
        if (value.kind == 0) revert InvalidTransition();
        ClockSnapshot memory clock = _validateCommon(
            value.mandateNullifier,
            value.mandateRoot,
            value.revocationRoot,
            value.revocationScheme,
            value.currentTime,
            value.settlementContext
        );
        _requireField(value.mandateSuccessorCommitment);
        _requireField(value.mandateSecondSuccessorCommitment);

        bytes32[] memory publicInputs = new bytes32[](9);
        publicInputs[0] = bytes32(uint256(value.kind));
        publicInputs[1] = value.mandateNullifier;
        publicInputs[2] = value.mandateSuccessorCommitment;
        publicInputs[3] = value.mandateSecondSuccessorCommitment;
        publicInputs[4] = value.mandateRoot;
        publicInputs[5] = value.revocationRoot;
        publicInputs[6] = bytes32(uint256(value.revocationScheme));
        publicInputs[7] = bytes32(uint256(value.currentTime));
        publicInputs[8] = value.settlementContext;
        if (!_verify(MANDATE_ONLY_VERIFIER, proof, publicInputs)) revert InvalidProof();

        IZKMSettlementTarget.MandateLeafIndices memory indices = TARGET.applyZkmMandateTransition(
            IZKMSettlementTarget.MandateEffects({
                mandateNullifier: value.mandateNullifier,
                mandateSuccessorCommitment: value.mandateSuccessorCommitment,
                mandateSecondSuccessorCommitment: value.mandateSecondSuccessorCommitment
            })
        );
        _requireMandateLeafIndices(value.mandateSuccessorCommitment, value.mandateSecondSuccessorCommitment, indices);
        _emitSettlementEvidence(false, publicInputs, proof, indices, clock);
        emit ZkmMandateTransitionSettled(
            value.mandateNullifier, value.mandateSuccessorCommitment, value.mandateSecondSuccessorCommitment
        );
    }

    function _emitSettlementEvidence(
        bool spend,
        bytes32[] memory publicInputs,
        bytes calldata proof,
        IZKMSettlementTarget.MandateLeafIndices memory indices,
        ClockSnapshot memory clock
    ) private {
        SettlementEvidenceData memory data;
        data.verifier = spend ? address(SPEND_CONJOINED_VERIFIER) : address(MANDATE_ONLY_VERIFIER);
        data.vkHash = spend ? SPEND_CONJOINED_VK_HASH : MANDATE_ONLY_VK_HASH;
        data.publicInputs = publicInputs;
        data.proof = proof;
        data.indices = indices;
        data.clock = clock;
        _publishSettlementEvidence(
            publicInputs[1], spend ? SPEND_CONJOINED_STATEMENT_ID : MANDATE_ONLY_STATEMENT_ID, data
        );
    }

    function _publishSettlementEvidence(
        bytes32 mandateNullifier,
        bytes32 statementId,
        SettlementEvidenceData memory data
    ) private {
        emit ZkmSettlementEvidence(
            mandateNullifier,
            statementId,
            address(TARGET),
            data.verifier,
            PROOF_SCHEME,
            TRANSCRIPT_TARGET,
            data.vkHash,
            data.publicInputs,
            data.proof,
            data.indices.successorLeafIndex,
            data.indices.secondSuccessorLeafIndex,
            data.clock.targetTime,
            data.clock.proofTimeWindow
        );
    }

    function _requireMandateLeafIndices(
        bytes32 first,
        bytes32 second,
        IZKMSettlementTarget.MandateLeafIndices memory indices
    ) internal pure {
        _requireMandateLeafIndex(first, indices.successorLeafIndex);
        _requireMandateLeafIndex(second, indices.secondSuccessorLeafIndex);
        if (
            first != bytes32(0) && second != bytes32(0)
                && indices.successorLeafIndex == indices.secondSuccessorLeafIndex
        ) {
            revert InvalidMandateLeafIndices();
        }
    }

    function _requireMandateLeafIndex(bytes32 commitment, uint64 index) internal pure {
        if (commitment == bytes32(0)) {
            if (index != NO_LEAF_INDEX) revert InvalidMandateLeafIndices();
        } else if (index > type(uint32).max) {
            revert InvalidMandateLeafIndices();
        }
    }

    function _requireAuthorizedVerifier(bytes32 statementId, IUltraVerifier verifier, bytes32 vkHash) internal view {
        if (!TARGET.isAuthorizedZkmVerifier(statementId, address(verifier), vkHash)) {
            revert UnauthorizedVerificationKey();
        }
    }

    function _validateCommon(
        bytes32 mandateNullifier,
        bytes32 mandateRoot,
        bytes32 revocationRoot,
        uint8 revocationScheme,
        uint64 currentTime,
        bytes32 settlementContext
    ) internal view returns (ClockSnapshot memory clock) {
        if (revocationScheme != REVOCATION_SCHEME) revert InvalidRevocationScheme();
        _requireNonzeroField(mandateNullifier);
        _requireNonzeroField(mandateRoot);
        _requireNonzeroField(revocationRoot);
        _requireNonzeroField(settlementContext);
        if (settlementContext != TARGET.zkmSettlementContext()) revert ContextMismatch();
        clock.targetTime = TARGET.zkmCurrentTime();
        clock.proofTimeWindow = TARGET.zkmProofTimeWindow();
        // Check the lower bound before subtracting; never compute now + W.
        if (currentTime < clock.targetTime || currentTime - clock.targetTime > clock.proofTimeWindow) {
            revert TimeMismatch();
        }
        if (!TARGET.isRecentMandateRoot(mandateRoot)) revert UnknownMandateRoot();
        if (!TARGET.isRecognizedRevocationRoot(revocationRoot)) revert UnknownRevocationRoot();
    }

    function _verify(IUltraVerifier verifier, bytes calldata proof, bytes32[] memory publicInputs)
        internal
        view
        returns (bool)
    {
        try verifier.verify(proof, publicInputs) returns (bool valid) {
            return valid;
        } catch {
            return false;
        }
    }

    function _requireNonzeroField(bytes32 value) internal pure {
        if (value == bytes32(0) || uint256(value) >= FIELD_MODULUS) revert InvalidField();
    }

    function _requireField(bytes32 value) internal pure {
        if (uint256(value) >= FIELD_MODULUS) revert InvalidField();
    }

    function _requireNonzeroDigest(bytes32 value) internal pure {
        if (value == bytes32(0)) revert InvalidVerificationKeyHash();
    }
}
